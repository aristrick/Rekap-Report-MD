# ==== SUPABASE ====
# Ambil dari Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Service Role Key -> JANGAN pernah expose ke client, hanya dipakai di API route server-side
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== TELEGRAM BOT ====
# Ambil dari @BotFather setelah /newbot
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret bebas, dipakai untuk validasi webhook (isi string acak sendiri)
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak-panjang

# ==== CRON ====
# Secret bebas untuk melindungi endpoint reminder dari akses publik
CRON_SECRET=ganti-dengan-string-acak-lainnya

# ==== APP ====
NEXT_PUBLIC_APP_URL=https://nama-app-kamu.vercel.app
